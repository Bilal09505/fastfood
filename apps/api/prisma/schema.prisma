// apps/api/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALESMAN
  MAKER
  SUPPLIER
}

enum OrderStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  READY
  COMPLETED
  CANCELLED
}

enum ExpenseCategory {
  RENT
  UTILITIES
  SALARIES
  MAINTENANCE
  SUPPLIES
  OTHER
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clients     Client[]
  salesOrders Order[]    @relation("SalesmanOrders")
  makerOrders Order[]    @relation("MakerOrders")
  purchases   Purchase[]
  expenses    Expense[]

  @@map("users")
}

model Client {
  id         String   @id @default(uuid())
  name       String
  phone      String?
  address    String?
  salesmanId String
  salesman   User     @relation(fields: [salesmanId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orders Order[]

  @@map("clients")
}

model Category {
  id        String     @id @default(uuid())
  name      String     @unique
  menuItems MenuItem[]

  @@map("categories")
}

model MenuItem {
  id          String   @id @default(uuid())
  name        String
  price       Decimal  @db.Decimal(10, 2)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  isAvailable Boolean  @default(true)
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]
  materials  MenuItemMaterial[]

  @@map("menu_items")
}

model Material {
  id            String  @id @default(uuid())
  name          String  @unique
  unit          String
  currentStock  Decimal @db.Decimal(10, 3)
  minStockLevel Decimal @db.Decimal(10, 3)
  costPerUnit   Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menuItems MenuItemMaterial[]
  purchases Purchase[]

  @@map("materials")
}

model MenuItemMaterial {
  id             String  @id @default(uuid())
  menuItemId     String
  materialId     String
  quantityNeeded Decimal @db.Decimal(10, 3)

  menuItem MenuItem  @relation(fields: [menuItemId], references: [id])
  material Material  @relation(fields: [materialId], references: [id])

  @@unique([menuItemId, materialId])
  @@map("menu_item_materials")
}

model Order {
  id          String      @id @default(uuid())
  salesmanId  String
  clientId    String?
  makerId     String?
  status      OrderStatus @default(PENDING)
  totalAmount Decimal     @db.Decimal(10, 2)
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  salesman User        @relation("SalesmanOrders", fields: [salesmanId], references: [id])
  client   Client?     @relation(fields: [clientId], references: [id])
  maker    User?       @relation("MakerOrders", fields: [makerId], references: [id])
  items    OrderItem[]

  @@map("orders")
}

model OrderItem {
  id         String  @id @default(uuid())
  orderId    String
  menuItemId String
  quantity   Int
  unitPrice  Decimal @db.Decimal(10, 2)

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@map("order_items")
}

model Purchase {
  id           String   @id @default(uuid())
  supplierId   String
  materialId   String
  quantity     Decimal  @db.Decimal(10, 3)
  costPerUnit  Decimal  @db.Decimal(10, 2)
  totalCost    Decimal  @db.Decimal(10, 2)
  purchaseDate DateTime @default(now())
  notes        String?
  createdAt    DateTime @default(now())

  supplier User     @relation(fields: [supplierId], references: [id])
  material Material @relation(fields: [materialId], references: [id])

  @@map("purchases")
}

model Expense {
  id           String          @id @default(uuid())
  category     ExpenseCategory
  description  String
  amount       Decimal         @db.Decimal(10, 2)
  date         DateTime
  recordedById String
  createdAt    DateTime        @default(now())

  recordedBy User @relation(fields: [recordedById], references: [id])

  @@map("expenses")
}
